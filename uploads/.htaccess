Options -Indexes -MultiViews
<IfModule mod_authz_core.c>
    <FilesMatch "(?i)\.(php|php3|php4|php5|php7|php8|phps|phar|phtml|pht|cgi|pl|py|sh|bash|asp|aspx|jsp|jspx|shtml|inc|conf|ini)$">
        Require all denied
    </FilesMatch>
    <FilesMatch "(?i)^\.">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule mod_authz_host.c>
    <FilesMatch "(?i)\.(php|php3|php4|php5|php7|php8|phps|phar|phtml|pht|cgi|pl|py|sh|bash|asp|aspx|jsp|jspx|shtml|inc|conf|ini)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
php_flag engine off
